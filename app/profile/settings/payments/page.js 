'use client'

import { useState, useEffect } from 'react'
import { useAuth } from '@/context/AuthContext'
import ProtectedRoute from '@/components/ProtectedRoute'
import BackHeader from '@/components/BackHeader'
import BottomNav from '@/components/BottomNav'
import { supabase } from '@/lib/supabase-browser'
import { CreditCard, Wallet, Clock, CheckCircle, XCircle, Plus } from 'lucide-react'

export default function PaymentSettings() {
  const { user } = useAuth()
  const [payments, setPayments] = useState([])
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    async function loadPayments() {
      if (!user) return

      const { data, error } = await supabase
        .from('payments')
        .select('*')
        .eq('user_id', user.id)
        .order('created_at', { ascending: false })
        .limit(20)

      if (error) {
        console.error('Error loading payments:', error)
        return
      }

      setPayments(data || [])
      setLoading(false)
    }

    loadPayments()
  }, [user])

  const getStatusIcon = (status) => {
    switch (status) {
      case 'paid':
      case 'success':
        return <CheckCircle className="w-4 h-4 text-green-500" />
      case 'pending':
        return <Clock className="w-4 h-4 text-yellow-500" />
      case 'failed':
      case 'cancelled':
        return <XCircle className="w-4 h-4 text-red-500" />
      default:
        return <Clock className="w-4 h-4 text-muted" />
    }
  }

  const formatDate = (date) => {
    return new Date(date).toLocaleDateString('en-ZA', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  }

  return (
    <ProtectedRoute requireRole>
      <div className="min-h-screen bg-paper pb-24">
        <BackHeader title="Payments" />

        <div className="p-4 space-y-4">
          {/* Summary card */}
          <div className="bg-gradient-to-r from-signal to-signalDark rounded-card p-4 text-white">
            <div className="flex items-center gap-3">
              <Wallet className="w-6 h-6" />
              <div>
                <p className="text-sm opacity-80">Total spent</p>
                <p className="text-2xl font-bold">
                  R {payments.filter(p => p.status === 'success' || p.status === 'paid')
                    .reduce((sum, p) => sum + (p.amount || 0), 0)
                    .toFixed(2)}
                </p>
              </div>
            </div>
          </div>

          {/* Payment history */}
          <div>
            <h2 className="font-display text-lg font-bold mb-3">Payment history</h2>
            {loading ? (
              <div className="text-center text-muted py-4">Loading...</div>
            ) : payments.length === 0 ? (
              <div className="bg-white rounded-card border border-line p-8 text-center">
                <CreditCard className="w-8 h-8 text-muted mx-auto mb-2" />
                <p className="text-muted">No payments yet</p>
                <p className="text-sm text-muted mt-1">
                  Payments appear here when you unlock contact details
                </p>
              </div>
            ) : (
              <div className="space-y-2">
                {payments.map((payment) => (
                  <div
                    key={payment.id}
                    className="bg-white rounded-card border border-line p-3 flex justify-between items-center"
                  >
                    <div className="flex items-center gap-3">
                      {getStatusIcon(payment.status)}
                      <div>
                        <p className="text-sm font-medium">
                          R {payment.amount?.toFixed(2) || '0.00'}
                        </p>
                        <p className="text-xs text-muted">
                          {formatDate(payment.created_at)}
                        </p>
                        {payment.paystack_ref && (
                          <p className="text-xs text-muted">
                            Ref: {payment.paystack_ref.slice(0, 12)}...
                          </p>
                        )}
                      </div>
                    </div>
                    <span className={`text-xs px-2 py-1 rounded-full capitalize
                      ${payment.status === 'success' || payment.status === 'paid'
                        ? 'bg-green-100 text-green-700'
                        : payment.status === 'pending'
                        ? 'bg-yellow-100 text-yellow-700'
                        : 'bg-red-100 text-red-700'
                      }`}
                    >
                      {payment.status || 'pending'}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Add payment method (placeholder) */}
          <div className="bg-white rounded-card border border-line p-4">
            <button className="w-full flex items-center justify-center gap-2 text-signal hover:text-signalDark transition text-sm font-medium">
              <Plus className="w-4 h-4" />
              Add payment method
            </button>
            <p className="text-xs text-muted text-center mt-2">
              Paystack handles all secure payments
            </p>
          </div>
        </div>

        <BottomNav />
      </div>
    </ProtectedRoute>
  )
}