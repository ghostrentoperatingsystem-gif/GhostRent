'use client'

import { useState, useEffect } from 'react'
import { useAuth } from '@/context/AuthContext'
import ProtectedRoute from '@/components/ProtectedRoute'
import BackHeader from '@/components/BackHeader'
import BottomNav from '@/components/BottomNav'
import { supabase } from '@/lib/supabase-browser'
import { MessageSquare, Clock, CheckCircle } from 'lucide-react'

export default function LandlordMessages() {
  const { user } = useAuth()
  const [conversations, setConversations] = useState([])
  const [loading, setLoading] = useState(true)
  const [selectedConversation, setSelectedConversation] = useState(null)
  const [messages, setMessages] = useState([])
  const [newMessage, setNewMessage] = useState('')
  const [sending, setSending] = useState(false)

  // Load all conversations (contact requests where user is receiver)
  useEffect(() => {
    async function loadConversations() {
      const { data, error } = await supabase
        .from('contact_requests')
        .select(`
          *,
          sender:sender_id (
            id,
            full_name,
            avatar_url,
            role
          ),
          property:property_id (
            id,
            title,
            price,
            listing_type,
            images
          )
        `)
        .eq('receiver_id', user?.id)
        .order('created_at', { ascending: false })

      if (error) {
        console.error('Error loading conversations:', error)
        return
      }

      // Filter to only show approved + paid conversations
      const activeConversations = data?.filter(
        req => req.status === 'approved' && req.payment_status === 'paid'
      ) || []

      setConversations(activeConversations)
      setLoading(false)
    }

    if (user) loadConversations()
  }, [user])

  // Load messages for selected conversation
  useEffect(() => {
    async function loadMessages() {
      if (!selectedConversation) return

      const { data, error } = await supabase
        .from('messages')
        .select('*')
        .eq('contact_request_id', selectedConversation.id)
        .order('created_at', { ascending: true })

      if (error) {
        console.error('Error loading messages:', error)
        return
      }

      setMessages(data || [])
    }

    loadMessages()
  }, [selectedConversation])

  // Subscribe to new messages
  useEffect(() => {
    if (!selectedConversation) return

    const channel = supabase
      .channel(`messages:${selectedConversation.id}`)
      .on(
        'postgres_changes',
        {
          event: 'INSERT',
          schema: 'public',
          table: 'messages',
          filter: `contact_request_id=eq.${selectedConversation.id}`
        },
        (payload) => {
          setMessages(prev => [...prev, payload.new])
        }
      )
      .subscribe()

    return () => channel.unsubscribe()
  }, [selectedConversation])

  const sendMessage = async () => {
    if (!newMessage.trim() || !selectedConversation || sending) return

    setSending(true)
    const { error } = await supabase
      .from('messages')
      .insert([{
        contact_request_id: selectedConversation.id,
        sender_id: user.id,
        receiver_id: selectedConversation.sender_id,
        content: newMessage.trim()
      }])

    if (error) {
      console.error('Error sending message:', error)
    } else {
      setNewMessage('')
    }
    setSending(false)
  }

  if (loading) {
    return (
      <ProtectedRoute requireRole>
        <div className="min-h-screen bg-paper">
          <BackHeader title="Messages" />
          <div className="p-4 text-center text-muted">Loading conversations...</div>
          <BottomNav />
        </div>
      </ProtectedRoute>
    )
  }

  return (
    <ProtectedRoute requireRole>
      <div className="min-h-screen bg-paper pb-24">
        <BackHeader title="Messages" />

        {conversations.length === 0 ? (
          <div className="p-8 text-center">
            <MessageSquare className="w-12 h-12 text-muted mx-auto mb-3" />
            <p className="text-muted">No active conversations yet</p>
            <p className="text-sm text-muted mt-1">
              Once a tenant pays the unlock fee, you can chat here
            </p>
          </div>
        ) : (
          <div className="flex flex-col h-[calc(100vh-120px)]">
            {/* Conversation list */}
            {!selectedConversation ? (
              <div className="p-4 space-y-3">
                {conversations.map((conv) => (
                  <button
                    key={conv.id}
                    onClick={() => setSelectedConversation(conv)}
                    className="w-full bg-white rounded-card border border-line p-4 text-left hover:shadow-md transition"
                  >
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-full bg-signal/10 flex items-center justify-center text-signal font-semibold">
                        {conv.sender?.full_name?.[0] || '?'}
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="font-medium">{conv.sender?.full_name || 'Unknown'}</p>
                        <p className="text-sm text-muted truncate">
                          {conv.property?.title || 'Property'}
                        </p>
                      </div>
                      {conv.payment_status === 'paid' && (
                        <CheckCircle className="w-4 h-4 text-green-500" />
                      )}
                    </div>
                  </button>
                ))}
              </div>
            ) : (
              // Chat view
              <div className="flex-1 flex flex-col">
                <div className="bg-white border-b border-line p-4 flex items-center gap-3 sticky top-0">
                  <button
                    onClick={() => setSelectedConversation(null)}
                    className="text-ink/70 hover:text-ink"
                  >
                    ←
                  </button>
                  <div className="w-8 h-8 rounded-full bg-signal/10 flex items-center justify-center text-signal font-semibold text-sm">
                    {selectedConversation.sender?.full_name?.[0] || '?'}
                  </div>
                  <div className="flex-1 min-w-0">
                    <p className="font-medium">{selectedConversation.sender?.full_name || 'Unknown'}</p>
                    <p className="text-xs text-muted">
                      {selectedConversation.property?.title}
                    </p>
                  </div>
                </div>

                <div className="flex-1 overflow-y-auto p-4 space-y-2">
                  {messages.map((msg) => (
                    <div
                      key={msg.id}
                      className={`max-w-[80%] p-3 rounded-card ${
                        msg.sender_id === user.id
                          ? 'bg-signal text-white ml-auto'
                          : 'bg-white border border-line'
                      }`}
                    >
                      <p className="text-sm">{msg.content}</p>
                      <p className="text-xs opacity-70 mt-1">
                        {new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                      </p>
                    </div>
                  ))}
                </div>

                <div className="bg-white border-t border-line p-3 flex gap-2 sticky bottom-0">
                  <input
                    type="text"
                    value={newMessage}
                    onChange={(e) => setNewMessage(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && sendMessage()}
                    placeholder="Type a message..."
                    className="flex-1 px-4 py-2 border border-line rounded-card focus:outline-none focus:ring-2 focus:ring-signal"
                  />
                  <button
                    onClick={sendMessage}
                    disabled={sending || !newMessage.trim()}
                    className="bg-signal text-white px-4 py-2 rounded-card hover:bg-signalDark disabled:opacity-50 disabled:cursor-not-allowed transition"
                  >
                    Send
                  </button>
                </div>
              </div>
            )}
          </div>
        )}

        <BottomNav />
      </div>
    </ProtectedRoute>
  )
}